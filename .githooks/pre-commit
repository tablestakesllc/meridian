#!/usr/bin/env bash
# Meridian pre-commit gate. Enable once per clone:  git config core.hooksPath .githooks
# Python: set MERIDIAN_PYTHON to an interpreter with pyyaml and pytest (default: python3).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
PY="${MERIDIAN_PYTHON:-python3}"

if ! "$PY" -c 'import yaml, pytest' 2>/dev/null; then
  echo "pre-commit: $PY lacks pyyaml/pytest. Install them (pip install pyyaml pytest) or set MERIDIAN_PYTHON." >&2
  exit 1
fi

echo "pre-commit: tests"
"$PY" -m pytest tests/ -q -p no:cacheprovider || { echo "pre-commit: tests failed — commit blocked." >&2; exit 1; }

echo "pre-commit: seed bundle checks"
"$PY" scripts/build_seed_bundle.py --check || { echo "pre-commit: bundle checks failed — commit blocked." >&2; exit 1; }

# Maintainers only: the private release guard lives in the agent_docs/ submodule.
if [ -x agent_docs/tools/release_guard.sh ]; then
  agent_docs/tools/release_guard.sh || { echo "pre-commit: release guard failed — commit blocked." >&2; exit 1; }
fi
